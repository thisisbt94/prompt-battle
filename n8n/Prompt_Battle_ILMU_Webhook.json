            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "authcheck1-c1",
              "leftValue": "={{ $json.headers['x-agent-token'] }}",
              "rightValue": "={{ $('Config (edit me)').first().json.sharedSecret }}",
              "operator": {
