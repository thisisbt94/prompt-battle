    {
      "id": "buildgen1",
      "name": "Build Generate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        160
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const cfg = $('Config (edit me)').first().json;\nconst body = $('Webhook').first().json.body;\n\nreturn [{\n  json: {\n    url: `${cfg.ilmuApiUrl}/chat/completions`,\n    apiKey: cfg.ilmuApiKey,\n    payload: {\n      model: cfg.ilmuModel,\n      temperature: 0.7,\n      max_tokens: 500,\n      messages: [\n        { role: 'system', content: \"You are ILMU, a helpful, concise workplace AI assistant. Answer the person's instruction directly and usefully. Keep it practical and under 180 words unless the instruction clearly calls for more.\" },\n        { role: 'user', content: `Challenge context: ${body.challenge}\\n\\nInstruction: ${body.prompt}` }\n      ]\n    }\n  }\n}];"
      }
    },
    {
      "id": "callilmugen1",
      "name": "Call ILMU (Generate)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        160
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.apiKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.payload }}",
        "options": {
          "timeout": 18000
        }
      }
    },
    {
      "id": "formatgen1",
      "name": "Format Generate Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1380,
        160
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const content = $input.first().json?.choices?.[0]?.message?.content;\nreturn [{ json: { success: true, response: content ?? '' } }];"
      }
    },
    {
      "id": "respondgen1",
      "name": "Respond Generate",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1620,
        160
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    },
    {
      "id": "buildjudge1",
      "name": "Build Judge Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        400
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const cfg = $('Config (edit me)').first().json;\nconst body = $('Webhook').first().json.body;\nconst judgeSystemPrompt = \"You are the judge for \\\"Prompt Battle\\\", a live conference activity. Two people wrote two different instructions (\\\"prompts\\\") for the same AI, in response to the same challenge. You will be given the challenge, both prompts, and both AI-generated responses.\\n\\nJudge which RESPONSE is more useful \\u2014 relevance, clarity, usefulness, understanding of context, specificity, and practicality. Do NOT reward a prompt just for being longer.\\n\\nReply with ONLY a JSON object, no preamble, no markdown fences, in exactly this shape:\\n{\\\"winner\\\":\\\"A\\\"|\\\"B\\\"|\\\"TIE\\\",\\\"scoreA\\\":0-100,\\\"scoreB\\\":0-100,\\\"reason\\\":\\\"one short sentence\\\",\\\"promptATips\\\":[\\\"...\\\",\\\"...\\\"],\\\"promptBTips\\\":[\\\"...\\\",\\\"...\\\"],\\\"lesson\\\":\\\"one short, general, teachable sentence about what made the stronger prompt work\\\"}\";\n\nreturn [{\n  json: {\n    url: `${cfg.ilmuApiUrl}/chat/completions`,\n    apiKey: cfg.ilmuApiKey,\n    payload: {\n      model: cfg.ilmuModel,\n      temperature: 0,\n      max_tokens: 400,\n      messages: [\n        { role: 'system', content: judgeSystemPrompt },\n        { role: 'user', content: JSON.stringify({\n            challenge: body.challenge,\n            promptA: body.promptA,\n            responseA: body.responseA,\n            promptB: body.promptB,\n            responseB: body.responseB\n          })\n        }\n      ]\n    }\n  }\n}];"
      }
    },
    {
      "id": "callilmujudge1",
      "name": "Call ILMU (Judge)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.apiKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.payload }}",
        "options": {
          "timeout": 18000
        }
      }
    },
    {
      "id": "formatjudge1",
